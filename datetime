package lab4;

import java.util.Scanner;

public class 200 {

    private int year, month, day;

    public Datetime(String dt) {
        String[] v = dt.split("[-./]");
        year = Integer.parseInt(v[0]);
        month = Integer.parseInt(v[1]);
        day = Integer.parseInt(v[2]);
    }

    private int getYearCode(int y) {
        return (y % 100 + (y % 100) / 4) % 7;
    }

    private int getMonthCode(int m) {
        int[] code = {0,3,3,6,1,4,6,2,5,0,3,5};
        return code[m - 1];
    }

    private int getCenturyCode(int c) {
        switch (c) {
            case 17: return 4;
            case 18: return 2;
            case 19: return 0;
            case 20: return 6;
            case 21: return 4;
            case 22: return 2;
            case 23: return 0;
            default: return 0;
        }
    }

    private int getLeapYearCode(int y, int m) {
        if (((y % 4 == 0 && y % 100 != 0) || y % 400 == 0) && (m == 1 || m == 2))
            return 1;
        return 0;
    }

    private int dayOfWeek() {
        return (getYearCode(year)
                + getMonthCode(month)
                + getCenturyCode(year / 100)
                + day
                - getLeapYearCode(year, month)) % 7;
    }

    public void printDayOfWeek() {
        String[] d = {"Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"};
        System.out.println(year + " оны " + month + "-р сарын " + day + " бол " + d[dayOfWeek()]);
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Огноо оруул (yyyy.mm.dd): ");
        String input = sc.nextLine();

        Datetime dt = new Datetime(input);
        dt.printDayOfWeek();
        sc.close();
    }
}
